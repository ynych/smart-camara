# 火山引擎 API 配置
VOLCANO_API_KEY=your-volcano-api-key-here
VOLCANO_ENDPOINT=your-endpoint-id-here
VOLCANO_MODEL=seedream

# 文本大模型（提示词生成）；与 Seedream 生图 endpoint 不同，填豆包/DeepSeek 等对话接入点 ID
VOLCANO_CHAT_ENDPOINT=your-chat-endpoint-id-here
# VOLCANO_CHAT_API_KEY=  # 可选，默认复用 VOLCANO_API_KEY

# 服务配置
BACKEND_PORT=8155
FRONTEND_PORT=5173
