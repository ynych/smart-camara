# 火山引擎 API 配置
VOLCANO_API_KEY=your-volcano-api-key-here
VOLCANO_ENDPOINT=your-endpoint-id-here
VOLCANO_MODEL=seedream

# 文本大模型（提示词生成，Doubao-2.0 等）。使用 ep- 接入点 + /api/v3/responses
VOLCANO_CHAT_API_KEY=your-ark-api-key-here
VOLCANO_CHAT_ENDPOINT=ep-your-chat-endpoint-id
# 与 lark-cli / curl 示例一致时可设 ARK_API_KEY（与 VOLCANO_CHAT_API_KEY 等价）
# ARK_API_KEY=
# 默认 responses；Doubao-1.x 等旧接入点可设 chat_completions
# VOLCANO_CHAT_API_MODE=responses

# 服务配置
BACKEND_PORT=8155
FRONTEND_PORT=5173

# Promptfoo：见 scripts/run-promptfoo.sh（从 Admin TestCases 自动导出，无需额外 env）
