# 火山引擎 API 配置
VOLCANO_API_KEY=your-volcano-api-key-here
VOLCANO_ENDPOINT=your-endpoint-id-here
VOLCANO_MODEL=seedream

# 文本大模型（提示词生成）。必须与 VOLCANO_API_KEY 同一项目下的「豆包对话」推理接入点（ep- 开头）
# 控制台：火山方舟 → 在线推理 → 创建接入点 → 选择豆包 Pro/Lite 等对话模型（勿选 Seedream）
VOLCANO_CHAT_ENDPOINT=ep-your-chat-endpoint-id
# 可选：主 endpoint 失败时依次尝试的模型/接入点 ID（逗号分隔）
# VOLCANO_CHAT_FALLBACK_MODELS=doubao-1-5-lite-32k-250115
# VOLCANO_CHAT_API_KEY=  # 可选，默认复用 VOLCANO_API_KEY

# 服务配置
BACKEND_PORT=8155
FRONTEND_PORT=5173
